# ==========================================
# NEXUS GAMING — ENVIRONMENT CONFIGURATION
# ==========================================

# Port for the Express full-stack server
PORT=5000

# Environment: development or production
NODE_ENV=production

# MongoDB Connection String:
# 1. Leave empty or local to use the built-in embedded in-memory MongoDB
# 2. Or paste your MongoDB Atlas URI:
# MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxx.mongodb.net/nexus_gaming?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/nexus_gaming

# JWT Authentication Secret Key
JWT_SECRET=nexus_gaming_jwt_secret_key_production_change_me_2026
JWT_EXPIRE=7d

# Frontend URL (for CORS)
CLIENT_URL=*
